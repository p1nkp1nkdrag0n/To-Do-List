NODE_ENV=production
# Defaults for the documented Caddy HTTPS deployment.
HOST=127.0.0.1
PORT=4100
DB_PATH=./data/v2/app.sqlite
UPLOAD_PATH=./data/v2/uploads
BACKUP_PATH=./data/v2/backups
MAX_UPLOAD_BYTES=209715200
SESSION_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_CODE=replace-with-a-unique-bootstrap-code

COOKIE_SECURE=true
TRUST_PROXY_HOPS=1

# For a trusted direct HTTP LAN deployment, replace the complete trio below.
# HOST=0.0.0.0
# COOKIE_SECURE=false
# TRUST_PROXY_HOPS=0
