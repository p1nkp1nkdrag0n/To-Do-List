NODE_ENV=production

# Caddy HTTPS defaults.
# For a trusted direct HTTP LAN deployment, use these settings instead:
# HOST=0.0.0.0
# COOKIE_SECURE=false
# TRUST_PROXY_HOPS=0
HOST=127.0.0.1
PORT=4100
COOKIE_SECURE=true
TRUST_PROXY_HOPS=1

# Use absolute paths on the production host.
DB_PATH=D:\TeamManager\v2\app.sqlite
UPLOAD_PATH=D:\TeamManager\v2\uploads
BACKUP_PATH=D:\TeamManager\v2\backups
MAX_UPLOAD_BYTES=209715200

SESSION_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_CODE=replace-with-a-unique-bootstrap-code
