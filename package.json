{
  "name": "yancheng-team-project-manager",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "tsx watch server/v2.ts",
    "server:v2": "tsx server/v2.ts",
    "server:legacy": "node server/index.js",
    "e2e:server": "tsx tests/e2e/start-server.ts",
    "client:dev": "vite --host 0.0.0.0",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist-server/server/v2.js",
    "start:v2": "npm start",
    "start:legacy": "node server/index.js",
    "seed:demo:legacy": "node scripts/seed-demo.js",
    "invite:create": "tsx server/cli/create-registration-invite.ts",
    "backup:v2": "tsx server/cli/backup.ts",
    "restore:v2": "tsx server/cli/restore.ts",
    "test": "npm run test:v2",
    "test:v2": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:legacy": "node --test server/*.test.js src/*.test.js",
    "test:all": "npm run test:v2 && npm run test:legacy",
    "test:startup": "node --test server/startup.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "check": "npm run typecheck && npm run build && npm test && npm run test:e2e && npm audit --omit=dev"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "bcryptjs": "^2.4.3",
    "busboy": "^1.6.0",
    "concurrently": "^10.0.3",
    "express": "^4.21.2",
    "lucide-react": "^1.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "sql.js": "^1.12.0",
    "vite": "^8.0.16",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/busboy": "^1.5.4",
    "@types/express": "^4.17.25",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.0",
    "@types/ws": "^8.18.0",
    "supertest": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
