{
  "name": "team-project-manager-v1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "tsx watch server/index.js",
    "client:dev": "vite --host 0.0.0.0",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node server/index.js",
    "seed:demo": "node scripts/seed-demo.js",
    "invite:create": "node scripts/create-invites.js",
    "test": "npm run test:v2 && npm run test:legacy",
    "test:v2": "vitest run",
    "test:watch": "vitest",
    "test:legacy": "node --test server/*.test.js src/*.test.js",
    "test:all": "npm test",
    "test:startup": "node --test server/startup.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "check": "npm run typecheck && npm run build && npm test && npm audit --omit=dev"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "bcryptjs": "^2.4.3",
    "concurrently": "^10.0.3",
    "express": "^4.21.2",
    "lucide-react": "^1.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.12.0",
    "vite": "^8.0.16",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.0",
    "@types/ws": "^8.18.0",
    "supertest": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
