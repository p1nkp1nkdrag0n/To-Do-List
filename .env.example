# 复制这个文件为 .env，然后填上自己的值。
# .env 已被 .gitignore 排除，不会进仓库、不会上传。

# ---- 大模型（抽取员 / 协调员）----
# DeepSeek 开放平台：https://platform.deepseek.com
DEEPSEEK_API_KEY=
# 可选：想换成任何 OpenAI 兼容的服务（硅基流动、通义、智谱）
# LLM_PROVIDER=siliconflow
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# ---- 语音识别（思必驰，到赛场再配）----
# 控制台生成 APIKEY 时，IP 白名单填 0.0.0.0/0，否则换网络会 401
ASR_PROVIDER=fixture
# AISPEECH_PRODUCT_ID=
# AISPEECH_APIKEY=

# ---- 演示库 ----
# DB_PATH=data/v2/app.sqlite
